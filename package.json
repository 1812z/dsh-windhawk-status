{
  "name": "dsh-windhawk-status",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Publishes DSH session status to a Windhawk floating-window mod, and opens the matching conversation on request.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "windhawk",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "windhawk",
    "floating-window",
    "taskbar",
    "status"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
